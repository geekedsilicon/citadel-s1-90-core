{
  "//0":  "============================================================",
  "//1":  "VAELIX | PROJECT CITADEL — SYNTHESIS CONTROL PROTOCOL",
  "//2":  "File:    src/config.json",
  "//3":  "Target:  IHP 130nm SG13G2 | LibreLane 3.0.0.dev44",
  "//4":  "Standard: Vaelix Missionary Standard v1.2",
  "//5":  "FIX LOG:",
  "//6":  "  v1.1.0 — CLOCK_PERIOD 20->40 (25MHz stability target)",
  "//7":  "  v1.1.0 — Hold margins hardened (0.1->0.15, 0.05->0.1)",
  "//8":  "  v1.1.0 — PL_TARGET_DENSITY kept at 60 (sparse combinational design)",
  "//9":  "============================================================",

  "//A":  "--- PLACEMENT -------------------------------------------------",
  "//B":  "60% is correct for the sparse Sentinel gate count (~20 cells).",
  "//C":  "Increase to 65-80 only if GPL-0302 placement error occurs.",
  "PL_TARGET_DENSITY_PCT": 60,

  "//D":  "--- CLOCK PERIOD ----------------------------------------------",
  "//E":  "40ns = 25MHz. Stability over speed. Combinational so CTS is trivial.",
  "CLOCK_PERIOD": 40,

  "//F":  "--- HOLD SLACK MARGINS (HARDENED) -----------------------------",
  "//G":  "Increased beyond defaults for Citadel timing resilience.",
  "PL_RESIZER_HOLD_SLACK_MARGIN":  0.15,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.1,

  "//H":  "--- LINTING (MANDATORY) ---------------------------------------",
  "RUN_LINTER":             1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  "//I":  "--- CLOCK PORT ------------------------------------------------",
  "CLOCK_PORT": "clk",

  "//J":  "=== DO NOT MODIFY BELOW THIS LINE =============================",
  "//K":  "IHP SG13G2 / LibreLane structural requirements.",

  "RUN_KLAYOUT_XOR":               0,
  "RUN_KLAYOUT_DRC":               0,
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,

  "TOP_MARGIN_MULT":    1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT":   6,
  "RIGHT_MARGIN_MULT":  6,

  "FP_SIZING":          "absolute",
  "GRT_ALLOW_CONGESTION": 1,
  "FP_IO_HLENGTH":      2,
  "FP_IO_VLENGTH":      2,
  "FP_PDN_VPITCH":      38.87,

  "RUN_CTS":            1,
  "FP_PDN_MULTILAYER":  0,
  "MAGIC_DEF_LABELS":   0,
  "MAGIC_WRITE_LEF_PINONLY": 1
}
